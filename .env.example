# Copy locally; never commit real secrets. Default is isolated mock mode.
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
DATA_DIR=.data/dev
ADAPTER_MODE=mock
DATA_MODE=synthetic
# Set by scripts/start-personal.ps1 after validating ignored config/personal.json.
PERSONAL_CONFIG_JSON=
# PostgreSQL deployment: postgres://revflow_app:password@postgres:5432/revflow
DATABASE_URL=
API_TOKEN=
APPROVAL_TOKEN=
WEBHOOK_SECRET=
N8N_BASE_URL=http://localhost:5678
N8N_INGEST_URL=
N8N_SEND_URL=
N8N_REPLY_URL=
N8N_MEETING_URL=
N8N_FOLLOWUPS_URL=
N8N_OPERATIONS_URL=
REVFLOW_TUNNEL_PROTOCOL=http2
N8N_INBOUND_TOKEN=
N8N_GATEWAY_TOKEN=
CONNECTOR_GATEWAY_URL=
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE=
HUBSPOT_DEAL_STAGE=
GOOGLE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
GMAIL_SENDER=
GMAIL_TEST_RECIPIENT=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# AI uses an authenticated n8n structured-output workflow; no local model key.
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
